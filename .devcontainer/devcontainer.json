{
  "name": "ros2y",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "dev"
  },
  "runArgs": ["--network=host", "--ipc=host", "--pid=host"],
  "containerEnv": { "ROS_STATIC_PEERS": "100.96.218.61" },
  "workspaceFolder": "/home/ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/ubuntu/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/ubuntu/.claude.json,type=bind",
    "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind",
    "source=${localEnv:HOME}/.local/bin/tokensave,target=${localEnv:HOME}/.local/bin/tokensave,type=bind",
    "source=${localEnv:HOME}/.tokensave,target=/home/ubuntu/.tokensave,type=bind",
    "source=${localEnv:HOME}/.local/state/herdr,target=${localEnv:HOME}/.local/state/herdr,type=bind",
    "source=${localEnv:HOME}/development/workspace/herdr-nostr,target=${localEnv:HOME}/development/workspace/herdr-nostr,type=bind,readonly"
  ],
  "remoteUser": "ubuntu"
}
